# Generated by electron-windows-msix. Creates (or reuses) a self-signed development
# certificate for signing the MSIX package. Placeholder values are injected by src/cert.ts.
$subjectName = '{{SubjectName}}'
$friendlyName = "electron-windows-msix dev cert ($subjectName)"
$yearsValid = 5
$pfxPasswordPlain = '{{Password}}'
$pfxOutputPath = '{{PfxOutputPath}}'
$cerOutputPath = '{{CerOutputPath}}'
$hasPassword = $pfxPasswordPlain -ne ""

# Convert password to SecureString
if ($hasPassword) {
  $pfxPassword = ConvertTo-SecureString -String $pfxPasswordPlain -Force -AsPlainText
}

# Look for an existing, still valid cert with matching subject and friendly name
$existingCert = Get-ChildItem -Path "cert:\CurrentUser\My" |
    Where-Object {
        $_.Subject -eq $subjectName -and $_.FriendlyName -eq $friendlyName -and $_.NotAfter -gt (Get-Date)
    }

if ($existingCert) {
  $cert = $existingCert | Sort-Object NotAfter -Descending | Select-Object -First 1
  $reused = $true
} else {
  # Certificate profile per Microsoft's MSIX package signing guidance: Code Signing EKU
  # (2.5.29.37) and an empty Basic Constraints extension (2.5.29.19) marking an
  # end-entity certificate. The key stays exportable so it can be handed to SignTool as a PFX.
  $cert = New-SelfSignedCertificate `
    -Type Custom `
    -Subject $subjectName `
    -FriendlyName $friendlyName `
    -KeyUsage DigitalSignature `
    -TextExtension @('2.5.29.37={text}1.3.6.1.5.5.7.3.3', '2.5.29.19={text}') `
    -KeyAlgorithm RSA `
    -KeyLength 2048 `
    -KeyExportPolicy Exportable `
    -NotAfter (Get-Date).AddYears($yearsValid) `
    -CertStoreLocation "cert:\CurrentUser\My"
  $reused = $false
}

# Export public certificate (.cer)
Export-Certificate -Cert $cert -FilePath $cerOutputPath

# Export private certificate with password (.pfx)
if ($hasPassword) {
  Export-PfxCertificate -Cert $cert -FilePath $pfxOutputPath -Password $pfxPassword
}

Write-Output "DEV_CERT_REUSED=$reused"
